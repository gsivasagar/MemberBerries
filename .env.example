# Supabase project settings (Project settings -> API). The anon key is public by design:
# it is only safe because Row Level Security is enabled on the bookmarks table (see supabase/policies.sql).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
